{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "production": {
      "extends": "fork-apk"
    },
    "production-apk": {
      "extends": "fork-apk"
    },
    "fork-apk": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "fork"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote",
        "gradleCommand": ":app:createBundleReleaseJsAndAssets :app:assembleRelease -PreactNativeArchitectures=arm64-v8a --no-daemon --max-workers=1 -Dorg.gradle.parallel=false -Dorg.gradle.jvmargs=-Xmx2048m -x lint -x lintVitalAnalyzeRelease -x lintVitalRelease -x generateReleaseLintModel -x generateReleaseLintVitalModel"
      }
    }
  }
}
